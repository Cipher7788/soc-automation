# Wazuh Indexer (required). Use an account with read access to wazuh-alerts-*.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY_SSL=true
WAZUH_INDEXER_CA_BUNDLE=
WAZUH_POLL_INTERVAL=60

# Wazuh Manager (optional, for manager API calls)
WAZUH_HOST=https://localhost:55000
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=true
WAZUH_CA_BUNDLE=

# Optional integrations. Leave credentials blank to disable each integration.
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=
SHUFFLE_URL=http://localhost:5001
SHUFFLE_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

LOG_LEVEL=INFO
ENVIRONMENT=production
ALERT_DEDUP_WINDOW=300
CACHE_TTL=3600
ML_MODEL_PATH=models/isolation_forest.pkl
RULES_DIR=rules
PLAYBOOKS_DIR=playbooks
IOC_DATABASE_PATH=data/ioc_database.json
REPORTS_DIR=reports
